{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Simple Voice Tool",
  "version": "0.9.3",
  "identifier": "com.theforeveriris.simplevoicetool",
  "build": {
    "frontendDist": "../docs",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Simple Voice Tool",
        "width": 440,
        "height": 920,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
